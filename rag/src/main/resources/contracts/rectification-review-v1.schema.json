{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeguard-agent/contracts/rectification-review-v1.schema.json",
  "title": "SafeGuard Rectification Review v1",
  "description": "Read-only suggestion for reviewing rectification evidence. It never accepts or rejects a business order.",
  "type": "object",
  "required": ["reviewId", "orderId", "orderVersion", "status", "criterionResults", "overallSuggestion", "workflowTrace"],
  "properties": {
    "reviewId": { "type": "string", "minLength": 1 },
    "orderId": { "type": "string", "minLength": 1 },
    "orderVersion": { "type": "integer", "minimum": 0 },
    "inputDigest": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["REVIEWED", "NEED_MORE_INFORMATION", "STALE"] },
    "criterionResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "result", "evidence", "reason"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "UNCERTAIN", "NOT_OBSERVABLE"] },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "remainingRisks": { "type": "array", "items": { "type": "string" } },
    "missingMaterials": { "type": "array", "items": { "type": "string" } },
    "overallSuggestion": { "type": "string", "enum": ["SUGGEST_ACCEPT", "SUGGEST_REJECT", "NEED_MORE_INFORMATION"] },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "requiresManualReview": { "type": "boolean" },
    "workflowTrace": { "type": "array", "items": { "$ref": "#/$defs/trace" } }
  },
  "$defs": {
    "trace": {
      "type": "object",
      "required": ["stage", "message", "executed"],
      "properties": { "stage": { "type": "string" }, "message": { "type": "string" }, "executed": { "type": "boolean" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
